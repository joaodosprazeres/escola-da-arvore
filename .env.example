# Front-end — únicas variáveis embutidas no bundle. Ambas públicas por natureza e inócuas
# porque toda tabela tem RLS. Valores locais são impressos por `supabase start`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Caminho base do deploy (GitHub Pages usa "/<nome-do-repositorio>/"). Vazio = raiz.
VITE_BASE_PATH=/

# Segredos das Edge Functions NÃO entram aqui: ficam em supabase/functions/.env,
# fora do versionamento (SUPABASE_SERVICE_ROLE_KEY, LOGIN_IP_PEPPER, ALLOWED_ORIGIN, APP_BASE_URL).
